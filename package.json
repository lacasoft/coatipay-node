{
  "name": "@lacasoft/coatipay-node",
  "version": "0.0.1",
  "private": true,
  "description": "CoatiPay node daemon — runs a community routing node",
  "main": "./dist/index.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@lacasoft/coatipay-protocol": "^0.1.3",
    "fastify": "^5.12.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "viem": "^2.56.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "license": "Apache-2.0",
  "homepage": "https://coatipay.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/lacasoft/coatipay-node"
  },
  "bugs": "https://github.com/lacasoft/coatipay-node/issues",
  "overrides": {
    "fast-uri@^3.0.0": "^3.1.8",
    "fast-uri@^4.0.0": "^4.2.1",
    "source-map-js@<1.2.2": "^1.2.2"
  }
}
